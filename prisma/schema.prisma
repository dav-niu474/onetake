generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// AI 视频创作画布工作流
model Workflow {
  id          String   @id @default(cuid())
  name        String   @default("未命名工作流")
  description String   @default("")
  // 完整画布图 { nodes: [], edges: [] }
  graph       String   @default("{\"nodes\":[],\"edges\":[]}")
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  executions  Execution[]
}

// 节点执行任务记录（支持异步轮询：视频生成等）
model Execution {
  id         String    @id @default(cuid())
  workflowId String?
  nodeId     String
  nodeType   String
  // idle | running | success | failed
  status     String    @default("running")
  progress   Int       @default(0)
  stage      String    @default("")
  // 远端异步任务 ID（视频生成等）：超时/中断后可凭此找回云端成果
  remoteTaskId String?
  // 输入快照
  input      String    @default("{}")
  params     String    @default("{}")
  // 输出 { [handleId]: { kind, url?, text?, mimeType? } }
  output     String?
  // 执行时刻的画布布局快照 { focus, nodes[{id,type,x,y,label,state}], edges[[s,sh,t,th]] }
  snapshot   String?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
}

// 模型供应商配置（按能力维度路由：llm | image | tts | video）
// providerKind: builtin = 内置 z-ai-web-dev-sdk；openai_compatible = OpenAI 兼容协议自定义供应商
model ProviderSetting {
  id           String   @id @default(cuid())
  capability   String   @unique // llm | image | tts | video
  providerKind String   @default("builtin") // builtin | openai_compatible
  baseUrl      String?
  apiKey       String?
  model        String?
  voice        String? // tts 专用：音色
  enabled      Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}
