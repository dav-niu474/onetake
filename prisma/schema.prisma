generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// AI 视频创作画布工作流
model Workflow {
  id          String   @id @default(cuid())
  name        String   @default("未命名工作流")
  description String   @default("")
  // 完整画布图 { nodes: [], edges: [] }
  graph       String   @default("{\"nodes\":[],\"edges\":[]}")
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  executions  Execution[]
}

// 节点执行任务记录（支持异步轮询：视频生成等）
model Execution {
  id         String    @id @default(cuid())
  workflowId String?
  nodeId     String
  nodeType   String
  // idle | running | success | failed
  status     String    @default("running")
  progress   Int       @default(0)
  stage      String    @default("")
  // 远端异步任务 ID（视频生成等）：超时/中断后可凭此找回云端成果
  remoteTaskId String?
  // 输入快照
  input      String    @default("{}")
  params     String    @default("{}")
  // 输出 { [handleId]: { kind, url?, text?, mimeType? } }
  output     String?
  // 执行时刻的画布布局快照 { focus, nodes[{id,type,x,y,label,state}], edges[[s,sh,t,th]] }
  snapshot   String?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
}

// 模型供应商账户（预置目录中的服务或自定义接入的实例）
// protocol: openai（OpenAI 兼容，覆盖绝大多数厂商）| anthropic | gemini
// models: JSON 字符串数组，来源 = 「测试连接」时拉取的模型列表 + 手动添加
// status: unverified 未验证 | ok 测试通过 | error 上次测试失败
model ProviderAccount {
  id            String   @id @default(cuid())
  presetId      String   @default("custom") // 预置 id（openai/deepseek/...），custom = 自定义
  name          String
  protocol      String   @default("openai")
  baseUrl       String
  apiKey        String?
  models        String   @default("[]")
  enabled       Boolean  @default(true)
  status        String   @default("unverified")
  statusMessage String?
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 能力路由（按能力维度指向某个供应商账户或内置服务）：llm | image | tts | video
// providerKind: builtin = 内置 z-ai-web-dev-sdk；account = 指向 accountId 供应商账户
//               openai_compatible = 旧版直填配置（首次读取时自动迁移为 account）
model ProviderSetting {
  id           String   @id @default(cuid())
  capability   String   @unique // llm | image | tts | video
  providerKind String   @default("builtin") // builtin | account | openai_compatible(legacy)
  accountId    String? // providerKind=account 时指向 ProviderAccount.id
  baseUrl      String?
  apiKey       String?
  model        String?
  voice        String? // tts 专用：音色
  enabled      Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}
